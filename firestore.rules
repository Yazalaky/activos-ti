rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profileActive() {
      return hasProfile()
        && (!userDoc().data.keys().hasAny(['active']) || userDoc().data.active == true);
    }

    function role() {
      return profileActive() ? userDoc().data.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isTech() {
      return role() == 'tech';
    }

    function isAuditor() {
      return role() == 'auditor';
    }

    function isManagement() {
      return role() == 'management';
    }

    function canWrite() {
      return isAdmin() || isTech();
    }

    function hasGlobalAccess() {
      return profileActive()
        && (!userDoc().data.keys().hasAny(['accessScope']) || userDoc().data.accessScope == 'global');
    }

    function hasAssignedSite(siteId) {
      return profileActive()
        && userDoc().data.keys().hasAll(['accessScope', 'siteIds'])
        && userDoc().data.accessScope == 'sites'
        && userDoc().data.siteIds is list
        && userDoc().data.siteIds.hasAny([siteId]);
    }

    function canReadSite(siteId) {
      return hasGlobalAccess() || hasAssignedSite(siteId);
    }

    function canWriteSite(siteId) {
      return canWrite() && canReadSite(siteId);
    }

    function userProfileValid() {
      let data = request.resource.data;
      let identityValid = data.keys().hasAll(['email', 'name', 'role'])
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.role in ['admin', 'tech', 'auditor', 'management'];
      let activeValid = !data.keys().hasAny(['active']) || data.active is bool;
      let scopeValid = !data.keys().hasAny(['accessScope'])
        || data.accessScope in ['global', 'sites'];
      let sitesValid = !data.keys().hasAny(['siteIds'])
        || (data.siteIds is list && data.siteIds.size() <= 30);
      let restrictedHasSites = !data.keys().hasAny(['accessScope'])
        || data.accessScope != 'sites'
        || (data.keys().hasAny(['siteIds']) && data.siteIds is list && data.siteIds.size() > 0);
      return identityValid && activeValid && scopeValid && sitesValid && restrictedHasSites;
    }

    function isNullOrString(value) {
      return value == null || (value is string);
    }

    function isNullOrShortString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    function isNullOrIntOrFloat(value) {
      return value == null || (value is int) || (value is float);
    }

    function isValidAssetImagePath(assetId, value) {
      return value is string
        && value.matches('assets/' + assetId + '/photos/[^/]+');
    }

    function isValidInvoiceAttachmentPath(invoiceId, value) {
      return value is string
        && value.matches('invoices/' + invoiceId + '/attachments/[^/]+');
    }

    function isValidQuoteAttachmentPath(quoteId, value) {
      return value is string
        && value.matches('quotes/' + quoteId + '/attachments/[^/]+');
    }

    function isValidActPdfPath(actId, value) {
      return value is string
        && value.matches('acts/' + actId + '/pdf/[^/]+');
    }

    function isValidMaintenanceEvidencePath(maintenanceId, value) {
      return value is string
        && value.matches('maintenances/' + maintenanceId + '/attachments/[^/]+');
    }

    function isValidInvoiceContentType(value) {
      return value is string
        && (value.matches('application/pdf') || value.matches('image/.*'));
    }

    function assetAttachmentValid(assetId) {
      let data = request.resource.data;

      // imagePath: must be null or match `assets/{assetId}/photos/{file}`
      let imagePathOk = !data.keys().hasAny(['imagePath'])
        || data.imagePath == null
        || isValidAssetImagePath(assetId, data.imagePath);

      // imageUrl: allow null or any string (can be a downloadURL)
      // We keep this intentionally permissive to avoid breaking existing URLs.
      let imageUrlOk = !data.keys().hasAny(['imageUrl'])
        || isNullOrShortString(data.imageUrl, 2048);

      return imagePathOk && imageUrlOk;
    }

    function assetLifecycleValid() {
      let data = request.resource.data;
      let statusValid = data.keys().hasAny(['status'])
        && data.status is string
        && data.status in ['bodega', 'asignado', 'mantenimiento', 'baja'];

      let decommissionValid = data.status != 'baja'
        || (
          data.keys().hasAll(['decommissionReason', 'decommissionedAt', 'decommissionedByUid'])
          && data.decommissionReason is string
          && data.decommissionReason.size() >= 5
          && data.decommissionReason.size() <= 1000
          && data.decommissionedAt is int
          && data.decommissionedByUid == request.auth.uid
          && (!data.keys().hasAny(['currentAssignment']) || data.currentAssignment == null)
        );

      return statusValid && decommissionValid;
    }

    function invoiceAttachmentValid(invoiceId) {
      let data = request.resource.data;

      let pdfPathOk = !data.keys().hasAny(['pdfPath'])
        || data.pdfPath == null
        || isValidInvoiceAttachmentPath(invoiceId, data.pdfPath);

      let pdfUrlOk = !data.keys().hasAny(['pdfUrl'])
        || isNullOrShortString(data.pdfUrl, 2048);

      let pdfNameOk = !data.keys().hasAny(['pdfName'])
        || isNullOrShortString(data.pdfName, 256);

      let pdfContentTypeOk = !data.keys().hasAny(['pdfContentType'])
        || data.pdfContentType == null
        || isValidInvoiceContentType(data.pdfContentType);

      let pdfSizeOk = !data.keys().hasAny(['pdfSize'])
        || (
          isNullOrIntOrFloat(data.pdfSize)
          && (data.pdfSize == null || (data.pdfSize >= 0 && data.pdfSize <= 10 * 1024 * 1024))
        );

      return pdfPathOk && pdfUrlOk && pdfNameOk && pdfContentTypeOk && pdfSizeOk;
    }

    function quoteAttachmentValid(quoteId) {
      let data = request.resource.data;

      let pdfPathOk = !data.keys().hasAny(['pdfPath'])
        || data.pdfPath == null
        || isValidQuoteAttachmentPath(quoteId, data.pdfPath);

      let pdfUrlOk = !data.keys().hasAny(['pdfUrl'])
        || isNullOrShortString(data.pdfUrl, 2048);

      let pdfNameOk = !data.keys().hasAny(['pdfName'])
        || isNullOrShortString(data.pdfName, 256);

      let pdfContentTypeOk = !data.keys().hasAny(['pdfContentType'])
        || data.pdfContentType == null
        || (data.pdfContentType is string && data.pdfContentType.matches('application/pdf'));

      let pdfSizeOk = !data.keys().hasAny(['pdfSize'])
        || (
          isNullOrIntOrFloat(data.pdfSize)
          && (data.pdfSize == null || (data.pdfSize >= 0 && data.pdfSize <= 10 * 1024 * 1024))
        );

      return pdfPathOk && pdfUrlOk && pdfNameOk && pdfContentTypeOk && pdfSizeOk;
    }

    function actAttachmentValid(actId) {
      let data = request.resource.data;

      let pdfPathOk = !data.keys().hasAny(['pdfPath'])
        || data.pdfPath == null
        || isValidActPdfPath(actId, data.pdfPath);

      let pdfUrlOk = !data.keys().hasAny(['pdfUrl'])
        || isNullOrShortString(data.pdfUrl, 2048);

      let pdfNameOk = !data.keys().hasAny(['pdfName'])
        || isNullOrShortString(data.pdfName, 256);

      let pdfContentTypeOk = !data.keys().hasAny(['pdfContentType'])
        || data.pdfContentType == null
        || (data.pdfContentType is string && data.pdfContentType.matches('application/pdf'));

      let pdfSizeOk = !data.keys().hasAny(['pdfSize'])
        || (
          isNullOrIntOrFloat(data.pdfSize)
          && (data.pdfSize == null || (data.pdfSize >= 0 && data.pdfSize <= 10 * 1024 * 1024))
        );

      return pdfPathOk && pdfUrlOk && pdfNameOk && pdfContentTypeOk && pdfSizeOk;
    }

    // USERS (perfiles)
    match /users/{uid} {
      allow read: if profileActive() && (uid == request.auth.uid || isAdmin());

      // Solo admin puede crear perfiles.
      allow create: if isAdmin() && userProfileValid();

      // El usuario puede actualizar su nombre; solo admin puede cambiar role/email.
      allow update: if isSignedIn() && (
        (uid == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name']))
        || (isAdmin()
          && userProfileValid()
          // El estado de Auth se cambia exclusivamente por la Cloud Function.
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['active']))
      ) && profileActive();

      allow delete: if isAdmin();
    }

    // SITES
    match /sites/{siteId} {
      allow read: if canReadSite(siteId);
      allow create: if canWrite() && hasGlobalAccess();
      allow update: if canWriteSite(siteId); // incluye assetSeq
      allow delete: if false;
    }

    // ASSETS
    match /assets/{assetId} {
      allow read: if canReadSite(resource.data.siteId);
      allow create: if canWriteSite(request.resource.data.siteId)
        && assetAttachmentValid(assetId) && assetLifecycleValid();
      allow update: if canWriteSite(resource.data.siteId)
        && canWriteSite(request.resource.data.siteId)
        && assetAttachmentValid(assetId)
        && assetLifecycleValid()
        // La baja es un estado final; no se puede reactivar por una edición común.
        && (resource.data.status != 'baja' || request.resource.data.status == 'baja');
      allow delete: if false;
    }

    // ACTIVITIES
    match /activities/{activityId} {
      allow read: if canReadSite(resource.data.siteId);
      allow create: if canWriteSite(request.resource.data.siteId);
      allow update: if canWriteSite(resource.data.siteId)
        && canWriteSite(request.resource.data.siteId);
      allow delete: if false;
    }

    // SUPPLIERS
    match /suppliers/{supplierId} {
      // Catálogo compartido; las transacciones que lo usan sí están limitadas por sede.
      allow read: if profileActive();
      allow create, update: if isAdmin() || (isTech() && hasGlobalAccess());
      allow delete: if false;
    }

    // INVOICES
    match /invoices/{invoiceId} {
      allow read: if canReadSite(resource.data.siteId);
      allow create: if canWriteSite(request.resource.data.siteId)
        && invoiceAttachmentValid(invoiceId);
      allow update: if canWriteSite(resource.data.siteId)
        && canWriteSite(request.resource.data.siteId)
        && invoiceAttachmentValid(invoiceId);
      allow delete: if false;
    }

    // QUOTES (Cotizaciones)
    match /quotes/{quoteId} {
      allow read: if canReadSite(resource.data.siteId);
      allow create: if canWriteSite(request.resource.data.siteId)
        && quoteAttachmentValid(quoteId);
      allow update: if canWriteSite(resource.data.siteId)
        && canWriteSite(request.resource.data.siteId)
        && quoteAttachmentValid(quoteId);
      allow delete: if false;
    }

    // ACTS (Actas de entrega)
    match /acts/{actId} {
      allow read: if canReadSite(resource.data.siteId);
      allow create: if canWriteSite(request.resource.data.siteId)
        && actAttachmentValid(actId);
      allow update: if canWriteSite(resource.data.siteId)
        && canWriteSite(request.resource.data.siteId)
        && actAttachmentValid(actId);
      allow delete: if false;
    }

    // MAINTENANCES
    match /maintenances/{maintenanceId} {
      allow read: if canReadSite(resource.data.siteId);
      allow create: if canWriteSite(request.resource.data.siteId)
        && request.resource.data.type in ['preventivo', 'correctivo']
        && request.resource.data.status in ['programado', 'en_proceso', 'realizado', 'cancelado'];
      allow update: if canWriteSite(resource.data.siteId)
        && canWriteSite(request.resource.data.siteId)
        && request.resource.data.type in ['preventivo', 'correctivo']
        && request.resource.data.status in ['programado', 'en_proceso', 'realizado', 'cancelado']
        && (!request.resource.data.keys().hasAny(['evidencePath']) || request.resource.data.evidencePath == null || isValidMaintenanceEvidencePath(maintenanceId, request.resource.data.evidencePath))
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDeleted', 'deletedAt', 'deletedByUid']));
      allow delete: if false; // physical delete blocked
    }
  }
}
