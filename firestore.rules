rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profileActive() {
      return hasProfile()
        && (!userDoc().data.keys().hasAny(['active']) || userDoc().data.active == true);
    }

    function role() {
      return profileActive() ? userDoc().data.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isTech() {
      return role() == 'tech';
    }

    function isAuditor() {
      return role() == 'auditor';
    }

    function isManagement() {
      return role() == 'management';
    }

    function canWrite() {
      return isAdmin() || isTech();
    }

    function hasGlobalAccess() {
      return profileActive()
        && (!userDoc().data.keys().hasAny(['accessScope']) || userDoc().data.accessScope == 'global');
    }

    function hasAssignedSite(siteId) {
      return profileActive()
        && userDoc().data.keys().hasAll(['accessScope', 'siteIds'])
        && userDoc().data.accessScope == 'sites'
        && userDoc().data.siteIds is list
        && userDoc().data.siteIds.hasAny([siteId]);
    }

    function canReadSite(siteId) {
      return hasGlobalAccess() || hasAssignedSite(siteId);
    }

    function canWriteSite(siteId) {
      return canWrite() && canReadSite(siteId);
    }

    function canCreateActOnSite(siteId) {
      let hasUserProfile = hasProfile();
      let profile = hasUserProfile ? userDoc().data : {};
      return hasUserProfile
        && (!profile.keys().hasAny(['active']) || profile.active == true)
        && profile.role in ['admin', 'tech']
        && (
          !profile.keys().hasAny(['accessScope'])
          || profile.accessScope == 'global'
          || (
            profile.accessScope == 'sites'
            && profile.keys().hasAny(['siteIds'])
            && profile.siteIds is list
            && profile.siteIds.hasAny([siteId])
          )
        );
    }

    function canManageContracts() {
      return isAdmin() || (isTech() && hasGlobalAccess());
    }

    function canReadContracts() {
      return canManageContracts() || isAuditor() || isManagement();
    }

    function userProfileValid() {
      let data = request.resource.data;
      let identityValid = data.keys().hasAll(['email', 'name', 'role'])
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.role in ['admin', 'tech', 'auditor', 'management'];
      let activeValid = !data.keys().hasAny(['active']) || data.active is bool;
      let scopeValid = !data.keys().hasAny(['accessScope'])
        || data.accessScope in ['global', 'sites'];
      let sitesValid = !data.keys().hasAny(['siteIds'])
        || (data.siteIds is list && data.siteIds.size() <= 30);
      let restrictedHasSites = !data.keys().hasAny(['accessScope'])
        || data.accessScope != 'sites'
        || (data.keys().hasAny(['siteIds']) && data.siteIds is list && data.siteIds.size() > 0);
      return identityValid && activeValid && scopeValid && sitesValid && restrictedHasSites;
    }

    function isNullOrString(value) {
      return value == null || (value is string);
    }

    function isNullOrShortString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    function isNullOrIntOrFloat(value) {
      return value == null || (value is int) || (value is float);
    }

    function isValidAssetImagePath(assetId, value) {
      return value is string
        && value.matches('assets/' + assetId + '/photos/[^/]+');
    }

    function isValidInvoiceAttachmentPath(invoiceId, value) {
      return value is string
        && value.matches('invoices/' + invoiceId + '/attachments/[^/]+');
    }

    function isValidQuoteAttachmentPath(quoteId, value) {
      return value is string
        && value.matches('quotes/' + quoteId + '/attachments/[^/]+');
    }

    function isValidActPdfPath(actId, value) {
      return value is string
        && value.matches('acts/' + actId + '/(pdf|generated|signed)/[^/]+');
    }

    function isValidActTemplatePath(companyId, kind, value) {
      return value is string
        && value.matches('act-templates/' + companyId + '/' + kind + '/[^/]+');
    }

    function isValidMaintenanceEvidencePath(maintenanceId, value) {
      return value is string
        && value.matches('maintenances/' + maintenanceId + '/attachments/[^/]+');
    }

    function isValidInvoiceContentType(value) {
      return value is string
        && (value.matches('application/pdf') || value.matches('image/.*'));
    }

    function assetAttachmentValid(assetId) {
      let data = request.resource.data;

      // imagePath: must be null or match `assets/{assetId}/photos/{file}`
      let imagePathOk = !data.keys().hasAny(['imagePath'])
        || data.imagePath == null
        || isValidAssetImagePath(assetId, data.imagePath);

      // imageUrl: allow null or any string (can be a downloadURL)
      // We keep this intentionally permissive to avoid breaking existing URLs.
      let imageUrlOk = !data.keys().hasAny(['imageUrl'])
        || isNullOrShortString(data.imageUrl, 2048);

      return imagePathOk && imageUrlOk;
    }

    function assetImageUpdateValid(assetId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(['imageUrl', 'imagePath', 'updatedAt', 'updatedByUid'])
        && assetAttachmentValid(assetId)
        && auditUpdateValid();
    }

    // Permite reparar la asignación de activos antiguos sin volver a validar
    // todos sus campos históricos. Solo se pueden modificar la asignación y
    // los campos de auditoría, y la asignación debe quedar completa.
    function assetAssignmentUpdateValid() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      return changedKeys.hasAny(['currentAssignment'])
        && changedKeys.hasOnly(['currentAssignment', 'status', 'updatedAt', 'updatedByUid'])
        && data.keys().hasAny(['status'])
        && data.status == 'asignado'
        && data.keys().hasAny(['currentAssignment'])
        && data.currentAssignment is map
        && data.currentAssignment.keys().hasAll(['assignedToName', 'assignedToPosition', 'assignedToResponsible', 'assignedAt'])
        && isNonEmptyString(data.currentAssignment.assignedToName, 200)
        && isNonEmptyString(data.currentAssignment.assignedToPosition, 150)
        && isNonEmptyString(data.currentAssignment.assignedToResponsible, 200)
        && data.currentAssignment.assignedAt is int
        && data.currentAssignment.assignedAt > 0
        && auditUpdateValid();
    }

    function assetStatusUpdateValid() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      return changedKeys.hasAny(['status'])
        && changedKeys.hasOnly(['status', 'currentAssignment', 'updatedAt', 'updatedByUid'])
        && data.keys().hasAny(['status'])
        && data.status in ['bodega', 'mantenimiento']
        && data.keys().hasAny(['currentAssignment'])
        && data.currentAssignment == null
        && auditUpdateValid();
    }

    // Permite actualizar campos ordinarios de documentos antiguos que todavía
    // no cumplen todo el esquema nuevo. Los campos críticos y la asignación
    // siguen teniendo rutas de validación independientes.
    function assetLegacyFieldUpdateValid() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      let editableKeys = [
        'type', 'brand', 'model', 'serial', 'internalPlate', 'purchaseDate', 'cost',
        'processor', 'ram', 'storage', 'os', 'monitorBrand', 'monitorSize',
        'monitorSerial', 'notes', 'updatedAt', 'updatedByUid'
      ];
      let identityValid = (!data.keys().hasAny(['type']) || data.type in ['laptop', 'desktop', 'monitor', 'keyboard', 'mouse', 'printer', 'scanner', 'network', 'other'])
        && (!data.keys().hasAny(['brand']) || isNonEmptyString(data.brand, 100))
        && (!data.keys().hasAny(['model']) || isNonEmptyString(data.model, 150))
        && (!data.keys().hasAny(['serial']) || isNonEmptyString(data.serial, 150));
      let datesValid = !data.keys().hasAny(['purchaseDate']) || isOptionalDate(data.purchaseDate);
      let costValid = !data.keys().hasAny(['cost'])
        || (data.cost == null || ((data.cost is int || data.cost is float) && data.cost >= 0));
      let optionalFieldsValid = (!data.keys().hasAny(['internalPlate']) || isOptionalString(data.internalPlate, 100))
        && (!data.keys().hasAny(['processor']) || isOptionalString(data.processor, 150))
        && (!data.keys().hasAny(['ram']) || isOptionalString(data.ram, 100))
        && (!data.keys().hasAny(['storage']) || isOptionalString(data.storage, 100))
        && (!data.keys().hasAny(['os']) || isOptionalString(data.os, 100))
        && (!data.keys().hasAny(['monitorBrand']) || isOptionalString(data.monitorBrand, 100))
        && (!data.keys().hasAny(['monitorSize']) || isOptionalString(data.monitorSize, 50))
        && (!data.keys().hasAny(['monitorSerial']) || isOptionalString(data.monitorSerial, 150))
        && (!data.keys().hasAny(['notes']) || isOptionalString(data.notes, 2000));
      return changedKeys.hasAny(['type', 'brand', 'model', 'serial', 'internalPlate', 'purchaseDate', 'cost', 'processor', 'ram', 'storage', 'os', 'monitorBrand', 'monitorSize', 'monitorSerial', 'notes'])
        && changedKeys.hasOnly(editableKeys)
        && data.keys().hasAny(['siteId'])
        && data.siteId == resource.data.siteId
        && data.keys().hasAny(['status'])
        && data.status == resource.data.status
        && identityValid
        && datesValid
        && costValid
        && optionalFieldsValid
        && auditUpdateValid();
    }

    function assetLifecycleValid() {
      let data = request.resource.data;
      let statusValid = data.keys().hasAny(['status'])
        && data.status is string
        && data.status in ['bodega', 'asignado', 'mantenimiento', 'baja'];

      let decommissionValid = !data.keys().hasAny(['status']) || data.status != 'baja'
        || (
          data.keys().hasAll(['decommissionReason', 'decommissionedAt', 'decommissionedByUid'])
          && data.decommissionReason is string
          && data.decommissionReason.size() >= 5
          && data.decommissionReason.size() <= 1000
          && data.decommissionedAt is int
          && data.decommissionedByUid == request.auth.uid
          && (!data.keys().hasAny(['currentAssignment']) || data.currentAssignment == null)
        );

      return statusValid && decommissionValid;
    }

    // Fase 2: los documentos nuevos deben llevar trazabilidad confiable.
    // En actualizaciones se conserva la auditoría existente y se exige el actor actual.
    function auditCreateValid() {
      let data = request.resource.data;
      return data.keys().hasAll(['createdAt', 'createdByUid'])
        && data.createdAt is int
        && data.createdAt > 0
        && data.createdByUid is string
        && data.createdByUid == request.auth.uid;
    }

    function auditUpdateValid() {
      let next = request.resource.data;
      let current = resource.data;
      let createdAtValid = !current.keys().hasAny(['createdAt'])
        || (next.keys().hasAny(['createdAt'])
          && next.createdAt is int
          && next.createdAt == current.createdAt);
      let createdByValid = !current.keys().hasAny(['createdByUid'])
        || (next.keys().hasAny(['createdByUid'])
          && next.createdByUid is string
          && next.createdByUid == current.createdByUid);
      return next.keys().hasAll(['updatedAt', 'updatedByUid'])
        && next.updatedAt is int
        && next.updatedAt > 0
        && next.updatedByUid is string
        && next.updatedByUid == request.auth.uid
        && createdAtValid
        && createdByValid;
    }

    function softDeleteValid() {
      let next = request.resource.data;
      let current = resource.data;
      let flagValid = !next.keys().hasAny(['isDeleted']) || next.isDeleted is bool;
      let deleteAuditValid = !next.keys().hasAny(['isDeleted'])
        || next.isDeleted != true
        || (
          next.keys().hasAll(['deletedAt', 'deletedByUid'])
          && next.deletedAt is int
          && next.deletedAt > 0
          && next.deletedByUid is string
          && next.deletedByUid == request.auth.uid
        );
      let cannotUndelete = !current.keys().hasAny(['isDeleted'])
        || current.isDeleted != true
        || (next.keys().hasAny(['isDeleted']) && next.isDeleted == true);
      let deleteAuditPreserved = !current.keys().hasAll(['isDeleted', 'deletedAt', 'deletedByUid'])
        || current.isDeleted != true
        || (
          next.keys().hasAll(['isDeleted', 'deletedAt', 'deletedByUid'])
          && next.isDeleted == true
          && next.deletedAt == current.deletedAt
          && next.deletedByUid == current.deletedByUid
        );
      return flagValid && deleteAuditValid && cannotUndelete && deleteAuditPreserved;
    }

    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isOptionalString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    function isDateString(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOptionalDate(value) {
      return value == null || value == '' || isDateString(value);
    }

    function siteDataValid() {
      let data = request.resource.data;
      let identityValid = data.keys().hasAll(['name', 'city', 'address', 'prefix'])
        && isNonEmptyString(data.name, 150)
        && isNonEmptyString(data.city, 100)
        && isNonEmptyString(data.address, 250)
        && data.prefix is string
        && data.prefix.matches('^[A-Z0-9]{2,8}$');
      let sequenceValid = !data.keys().hasAny(['assetSeq'])
        || (data.assetSeq is int && data.assetSeq >= 0);
      let releasedValid = !data.keys().hasAny(['releasedAssetSeqs'])
        || (data.releasedAssetSeqs is list && data.releasedAssetSeqs.size() <= 1000);
      let companyValid = !data.keys().hasAny(['companyId'])
        || isOptionalString(data.companyId, 100);
      return identityValid && sequenceValid && releasedValid && companyValid;
    }

    function assetAssignmentValid() {
      let data = request.resource.data;
      let assignedValid = !data.keys().hasAny(['status']) || data.status != 'asignado'
        || (
          data.keys().hasAny(['currentAssignment'])
          && data.currentAssignment is map
          && data.currentAssignment.keys().hasAll(['assignedToName', 'assignedToPosition', 'assignedToResponsible', 'assignedAt'])
          && isNonEmptyString(data.currentAssignment.assignedToName, 200)
          && isNonEmptyString(data.currentAssignment.assignedToPosition, 150)
          && isNonEmptyString(data.currentAssignment.assignedToResponsible, 200)
          && data.currentAssignment.assignedAt is int
          && data.currentAssignment.assignedAt > 0
        );
      let unassignedValid = !data.keys().hasAny(['status']) || data.status == 'asignado'
        || !data.keys().hasAny(['currentAssignment'])
        || data.currentAssignment == null;
      return assignedValid && unassignedValid;
    }

    function assetDataValid() {
      let data = request.resource.data;
      let identityValid = data.keys().hasAll(['fixedAssetId', 'type', 'brand', 'model', 'serial', 'status', 'siteId'])
        && isNonEmptyString(data.fixedAssetId, 50)
        && data.type in ['laptop', 'desktop', 'monitor', 'keyboard', 'mouse', 'printer', 'scanner', 'network', 'other']
        && isNonEmptyString(data.brand, 100)
        && isNonEmptyString(data.model, 150)
        && isNonEmptyString(data.serial, 150)
        && data.status in ['bodega', 'asignado', 'mantenimiento', 'baja']
        && isNonEmptyString(data.siteId, 150);
      let datesValid = !data.keys().hasAny(['purchaseDate']) || isOptionalDate(data.purchaseDate);
      let costValid = !data.keys().hasAny(['cost'])
        || (data.cost == null || ((data.cost is int || data.cost is float) && data.cost >= 0));
      let optionalFieldsValid = (!data.keys().hasAny(['internalPlate']) || isOptionalString(data.internalPlate, 100))
        && (!data.keys().hasAny(['processor']) || isOptionalString(data.processor, 150))
        && (!data.keys().hasAny(['ram']) || isOptionalString(data.ram, 100))
        && (!data.keys().hasAny(['storage']) || isOptionalString(data.storage, 100))
        && (!data.keys().hasAny(['os']) || isOptionalString(data.os, 100))
        && (!data.keys().hasAny(['monitorBrand']) || isOptionalString(data.monitorBrand, 100))
        && (!data.keys().hasAny(['monitorSize']) || isOptionalString(data.monitorSize, 50))
        && (!data.keys().hasAny(['monitorSerial']) || isOptionalString(data.monitorSerial, 150))
        && (!data.keys().hasAny(['notes']) || isOptionalString(data.notes, 2000))
        && (!data.keys().hasAny(['previousFixedAssetIds']) || (data.previousFixedAssetIds is list && data.previousFixedAssetIds.size() <= 10))
        && (!data.keys().hasAny(['movedAt']) || data.movedAt is int)
        && (!data.keys().hasAny(['movedFromSiteId']) || isOptionalString(data.movedFromSiteId, 150));
      return identityValid && datesValid && costValid && optionalFieldsValid && assetAssignmentValid();
    }

    function siteReferenceValid() {
      let data = request.resource.data;
      return data.keys().hasAny(['siteId'])
        && data.siteId is string
        && exists(/databases/$(database)/documents/sites/$(data.siteId));
    }

    function activityDataValid() {
      let data = request.resource.data;
      let identityValid = data.keys().hasAll(['date', 'techName', 'siteId', 'description', 'type', 'priority'])
        && isDateString(data.date)
        && isNonEmptyString(data.techName, 200)
        && isNonEmptyString(data.siteId, 150)
        && isNonEmptyString(data.description, 4000)
        && data.type in ['Soporte Usuario', 'Requerimiento', 'Capacitacion', 'Otro']
        && data.priority in ['alta', 'media', 'baja'];
      let assetIdValid = !data.keys().hasAny(['assetId'])
        || data.assetId == null
        || (data.assetId is string && data.assetId.size() > 0);
      let timeValid = !data.keys().hasAny(['timeSpentMinutes'])
        || data.timeSpentMinutes == null
        || ((data.timeSpentMinutes is int || data.timeSpentMinutes is float) && data.timeSpentMinutes >= 0);
      return identityValid && assetIdValid && timeValid;
    }

    function activityReferencesValid() {
      let data = request.resource.data;
      let siteValid = data.keys().hasAny(['siteId'])
        && data.siteId is string
        && exists(/databases/$(database)/documents/sites/$(data.siteId));
      let assetValid = !data.keys().hasAny(['assetId'])
        || data.assetId == null
        || (
          data.assetId is string
          && exists(/databases/$(database)/documents/assets/$(data.assetId))
          && get(/databases/$(database)/documents/assets/$(data.assetId)).data.siteId == data.siteId
        );
      return siteValid && assetValid;
    }

    function supplierDataValid() {
      let data = request.resource.data;
      let identityValid = data.keys().hasAll(['name', 'nit'])
        && isNonEmptyString(data.name, 200)
        && isNonEmptyString(data.nit, 80);
      let optionalValid = (!data.keys().hasAny(['contactName']) || isOptionalString(data.contactName, 200))
        && (!data.keys().hasAny(['phone']) || isOptionalString(data.phone, 80))
        && (!data.keys().hasAny(['email']) || isOptionalString(data.email, 254))
        && (!data.keys().hasAny(['category']) || isOptionalString(data.category, 100));
      let emailValid = !data.keys().hasAny(['email'])
        || data.email == null
        || data.email == ''
        || (data.email is string && data.email.matches('.*@.*'));
      return identityValid && optionalValid && emailValid;
    }

    function googleOneAccountDataValid(accountId) {
      let data = request.resource.data;
      return data.keys().hasAll(['accountEmail', 'cardLastFour', 'plan', 'storage', 'monthlyPrice', 'billingDay', 'active'])
        && data.keys().hasOnly([
          'accountEmail', 'cardLastFour', 'plan', 'storage', 'monthlyPrice', 'billingDay', 'active',
          'createdAt', 'createdByUid', 'updatedAt', 'updatedByUid'
        ])
        && isNonEmptyString(data.accountEmail, 254)
        && data.accountEmail.matches('.*@.*')
        && accountId == data.accountEmail
        && data.cardLastFour is string
        && data.cardLastFour.matches('^[0-9]{4}$')
        && isNonEmptyString(data.plan, 120)
        && isNonEmptyString(data.storage, 80)
        && data.monthlyPrice is int
        && data.monthlyPrice >= 0
        && data.monthlyPrice <= 999999999
        && data.billingDay is int
        && data.billingDay >= 1
        && data.billingDay <= 31
        && data.active is bool;
    }

    function supplierContractDataValid(contractId) {
      let data = request.resource.data;
      let fieldsValid = data.keys().hasAll(['supplierId', 'supplierNameSnapshot', 'object', 'status'])
        && data.keys().hasOnly([
          'supplierId', 'supplierNameSnapshot', 'object', 'contractNumber', 'signedDate',
          'startDate', 'endDate', 'currentRenewalDocumentId', 'renewalStartDate', 'renewalEndDate',
          'value', 'notes', 'status', 'currentSignedDocumentId', 'terminatedAt',
          'terminatedByUid', 'createdAt', 'createdByUid', 'updatedAt', 'updatedByUid'
        ])
        && isNonEmptyString(data.supplierId, 150)
        && isNonEmptyString(data.supplierNameSnapshot, 200)
        && isNonEmptyString(data.object, 1000)
        && data.status in ['active', 'terminated']
        && data.keys().hasAll(['currentSignedDocumentId'])
        && data.currentSignedDocumentId is string
        && data.currentSignedDocumentId.size() <= 200;
      let supplierValid = exists(/databases/$(database)/documents/suppliers/$(data.supplierId));
      let optionalFieldsValid = (!data.keys().hasAny(['contractNumber']) || isOptionalString(data.contractNumber, 120))
        && (!data.keys().hasAny(['signedDate']) || isOptionalDate(data.signedDate))
        && (!data.keys().hasAny(['startDate']) || isOptionalDate(data.startDate))
        && (!data.keys().hasAny(['endDate']) || isOptionalDate(data.endDate))
        && (!data.keys().hasAny(['notes']) || isOptionalString(data.notes, 4000));
      let periodValid = !data.keys().hasAll(['startDate', 'endDate'])
        || data.startDate == ''
        || data.endDate == ''
        || data.endDate >= data.startDate;
      let valueValid = !data.keys().hasAny(['value'])
        || data.value == null
        || ((data.value is int || data.value is float) && data.value >= 0 && data.value <= 1000000000000);
      let terminationValid = data.status != 'terminated'
        || (data.keys().hasAll(['terminatedAt', 'terminatedByUid'])
          && data.terminatedAt is int
          && data.terminatedAt > 0
          && isNonEmptyString(data.terminatedByUid, 150));
      let currentDocumentValid = data.currentSignedDocumentId == ''
        || (existsAfter(/databases/$(database)/documents/contracts/$(contractId)/documents/$(data.currentSignedDocumentId))
          && getAfter(/databases/$(database)/documents/contracts/$(contractId)/documents/$(data.currentSignedDocumentId)).data.kind == 'signed_contract');
      return fieldsValid && supplierValid && optionalFieldsValid && periodValid && valueValid
        && terminationValid && currentDocumentValid && supplierContractRenewalDataValid(contractId);
    }

    function supplierContractRenewalDataValid(contractId) {
      let data = request.resource.data;
      let renewalKeys = ['currentRenewalDocumentId', 'renewalStartDate', 'renewalEndDate'];
      let noneConfigured = !data.keys().hasAny(renewalKeys);
      let emptyConfigured = data.keys().hasAll(renewalKeys)
        && data.currentRenewalDocumentId == ''
        && data.renewalStartDate == ''
        && data.renewalEndDate == '';
      let periodConfigured = data.keys().hasAll(renewalKeys)
        && isNonEmptyString(data.currentRenewalDocumentId, 200)
        && isDateString(data.renewalStartDate)
        && isDateString(data.renewalEndDate)
        && data.renewalEndDate >= data.renewalStartDate
        && existsAfter(/databases/$(database)/documents/contracts/$(contractId)/documents/$(data.currentRenewalDocumentId))
        && getAfter(/databases/$(database)/documents/contracts/$(contractId)/documents/$(data.currentRenewalDocumentId)).data.kind == 'renewal'
        && getAfter(/databases/$(database)/documents/contracts/$(contractId)/documents/$(data.currentRenewalDocumentId)).data.renewalStartDate == data.renewalStartDate
        && getAfter(/databases/$(database)/documents/contracts/$(contractId)/documents/$(data.currentRenewalDocumentId)).data.renewalEndDate == data.renewalEndDate;
      return noneConfigured || emptyConfigured || periodConfigured;
    }

    function supplierContractDocumentDataValid(contractId, documentId) {
      let data = request.resource.data;
      let fieldsValid = data.keys().hasAll([
          'contractId', 'kind', 'title', 'storagePath', 'fileName', 'contentType', 'size'
        ])
        && data.keys().hasOnly([
          'contractId', 'kind', 'title', 'documentDate', 'storagePath', 'fileName',
          'contentType', 'size', 'replacesDocumentId', 'replacementReason', 'renewalStartDate',
          'renewalEndDate', 'createdAt', 'createdByUid', 'updatedAt', 'updatedByUid'
        ])
        && data.contractId == contractId
        && data.kind in ['signed_contract', 'addendum', 'renewal', 'other']
        && isNonEmptyString(data.title, 200)
        && data.storagePath == 'contracts/' + contractId + '/documents/' + documentId
        && isNonEmptyString(data.fileName, 240)
        && data.contentType == 'application/pdf'
        && data.size is int
        && data.size > 0
        && data.size < 20971520;
      let dateValid = !data.keys().hasAny(['documentDate']) || isOptionalDate(data.documentDate);
      let renewalPeriodValid = data.kind != 'renewal'
        ? !data.keys().hasAny(['renewalStartDate', 'renewalEndDate'])
        : data.keys().hasAll(['renewalStartDate', 'renewalEndDate'])
          && isDateString(data.renewalStartDate)
          && isDateString(data.renewalEndDate)
          && data.renewalEndDate >= data.renewalStartDate;
      let replacementValid = !data.keys().hasAny(['replacesDocumentId'])
        || (data.kind == 'signed_contract'
          && data.replacesDocumentId is string
          && exists(/databases/$(database)/documents/contracts/$(contractId)/documents/$(data.replacesDocumentId))
          && data.replacementReason is string
          && data.replacementReason.size() >= 5
          && data.replacementReason.size() <= 500);
      return fieldsValid && dateValid && renewalPeriodValid && replacementValid && auditCreateValid();
    }

    function supplierContractRenewalPeriodUpdateValid(contractId, documentId) {
      let current = resource.data;
      let next = request.resource.data;
      let changedKeys = next.diff(current).affectedKeys();
      let parentPath = /databases/$(database)/documents/contracts/$(contractId);
      let parentAfter = getAfter(parentPath).data;
      let fieldsValid = current.kind == 'renewal'
        && next.kind == 'renewal'
        && changedKeys.hasAny(['renewalStartDate', 'renewalEndDate'])
        && changedKeys.hasOnly(['renewalStartDate', 'renewalEndDate', 'updatedAt', 'updatedByUid'])
        && next.keys().hasAll(['renewalStartDate', 'renewalEndDate'])
        && isDateString(next.renewalStartDate)
        && isDateString(next.renewalEndDate)
        && next.renewalEndDate >= next.renewalStartDate
        && auditUpdateValid();
      let parentConsistent = parentAfter.currentRenewalDocumentId != documentId
        || (parentAfter.renewalStartDate == next.renewalStartDate
          && parentAfter.renewalEndDate == next.renewalEndDate);
      return exists(parentPath) && fieldsValid && parentConsistent;
    }

    function invoiceDataValid() {
      let data = request.resource.data;
      let identityValid = data.keys().hasAll(['supplierId', 'number', 'siteId', 'description', 'date', 'dueDate', 'total', 'status'])
        && isNonEmptyString(data.supplierId, 150)
        && isNonEmptyString(data.number, 100)
        && isNonEmptyString(data.siteId, 150)
        && isNonEmptyString(data.description, 4000)
        && isDateString(data.date)
        && isOptionalDate(data.dueDate)
        && (data.total is int || data.total is float)
        && data.total > 0
        && data.status in ['paid', 'pending'];
      let refsValid = data.keys().hasAll(['siteId', 'supplierId'])
        && data.siteId is string
        && data.supplierId is string
        && exists(/databases/$(database)/documents/sites/$(data.siteId))
        && exists(/databases/$(database)/documents/suppliers/$(data.supplierId));
      return identityValid && refsValid;
    }

    function quoteDataValid() {
      let data = request.resource.data;
      let identityValid = data.keys().hasAll(['date', 'supplierId', 'siteId', 'status'])
        && isDateString(data.date)
        && isNonEmptyString(data.supplierId, 150)
        && isNonEmptyString(data.siteId, 150)
        && data.status in ['pending', 'approved', 'rejected'];
      let notesValid = !data.keys().hasAny(['notes']) || isOptionalString(data.notes, 4000);
      let refsValid = data.keys().hasAll(['siteId', 'supplierId'])
        && data.siteId is string
        && data.supplierId is string
        && exists(/databases/$(database)/documents/sites/$(data.siteId))
        && exists(/databases/$(database)/documents/suppliers/$(data.supplierId));
      return identityValid && notesValid && refsValid;
    }

    function actDataValid() {
      let data = request.resource.data;
      let identityValid = data.keys().hasAll(['assetId', 'siteId', 'companyId', 'templateId', 'fixedAssetIdSnapshot', 'assetSnapshot', 'recipient', 'status'])
        && isNonEmptyString(data.assetId, 150)
        && isNonEmptyString(data.siteId, 150)
        && isNonEmptyString(data.companyId, 100)
        && isNonEmptyString(data.templateId, 100)
        && isNonEmptyString(data.fixedAssetIdSnapshot, 50)
        && data.assetSnapshot is map
        && data.assetSnapshot.keys().hasAll(['type', 'brand', 'model', 'serial'])
        && data.recipient is map
        && data.recipient.keys().hasAll(['fullName', 'position'])
        && isNonEmptyString(data.recipient.fullName, 200)
        && isNonEmptyString(data.recipient.position, 150)
        && (!data.recipient.keys().hasAny(['email']) || isOptionalString(data.recipient.email, 254))
        && (!data.recipient.keys().hasAny(['documentNumber']) || isOptionalString(data.recipient.documentNumber, 80))
        && (!data.recipient.keys().hasAny(['area']) || isOptionalString(data.recipient.area, 150))
        && (!data.recipient.keys().hasAny(['phone']) || isOptionalString(data.recipient.phone, 80))
        && (!data.recipient.keys().hasAny(['extension']) || isOptionalString(data.recipient.extension, 30))
        && (!data.recipient.keys().hasAny(['networkUser']) || isOptionalString(data.recipient.networkUser, 150))
        && data.status in ['draft', 'issued', 'signed', 'void'];
      let snapshotValid = data.keys().hasAny(['assetSnapshot'])
        && data.assetSnapshot is map
        && data.assetSnapshot.keys().hasAll(['type', 'brand', 'model', 'serial'])
        && isNonEmptyString(data.assetSnapshot.type, 50)
        && isNonEmptyString(data.assetSnapshot.brand, 100)
        && isNonEmptyString(data.assetSnapshot.model, 150)
        && isNonEmptyString(data.assetSnapshot.serial, 150)
        && (!data.assetSnapshot.keys().hasAny(['processor']) || isOptionalString(data.assetSnapshot.processor, 150))
        && (!data.assetSnapshot.keys().hasAny(['ram']) || isOptionalString(data.assetSnapshot.ram, 100))
        && (!data.assetSnapshot.keys().hasAny(['storage']) || isOptionalString(data.assetSnapshot.storage, 100))
        && (!data.assetSnapshot.keys().hasAny(['os']) || isOptionalString(data.assetSnapshot.os, 100));
      let recipientEmailValid = data.keys().hasAny(['recipient'])
        && data.recipient is map
        && (!data.recipient.keys().hasAny(['email'])
        || data.recipient.email == null
        || data.recipient.email == ''
        || (data.recipient.email is string && data.recipient.email.matches('.*@.*')));
      let refsValid = data.keys().hasAll(['siteId', 'assetId'])
        && data.siteId is string
        && data.assetId is string
        && exists(/databases/$(database)/documents/sites/$(data.siteId))
        && exists(/databases/$(database)/documents/assets/$(data.assetId))
        && get(/databases/$(database)/documents/assets/$(data.assetId)).data.siteId == data.siteId;
      return identityValid && snapshotValid && recipientEmailValid && refsValid;
    }

    function actDocumentDetailsValid(details) {
      let identityValid = details is map
        && details.keys().hasAll(['deviceTypes', 'standardSoftware', 'requestedSoftware', 'discountSources'])
        && details.keys().hasOnly([
          'deliveredByName', 'deviceTypes', 'otherDeviceType', 'charger', 'mouse', 'monitor', 'license',
          'keyboard', 'phoneSerial', 'phoneImei', 'standardSoftware', 'requestedSoftware',
          'otherSoftware', 'partyType', 'discountSources', 'discountAmountWords', 'discountAmountValue'
        ]);
      let deviceTypesValid = details.deviceTypes is map
        && details.deviceTypes.keys().hasAll(['desktop', 'laptop', 'printer', 'tablet', 'cellphone', 'other'])
        && details.deviceTypes.keys().hasOnly(['desktop', 'laptop', 'printer', 'tablet', 'cellphone', 'other'])
        && details.deviceTypes.desktop is bool
        && details.deviceTypes.laptop is bool
        && details.deviceTypes.printer is bool
        && details.deviceTypes.tablet is bool
        && details.deviceTypes.cellphone is bool
        && details.deviceTypes.other is bool;
      let standardSoftwareValid = details.standardSoftware is map
        && details.standardSoftware.keys().hasAll(['office365', 'antivirus', 'adobeReader', 'sevenZip', 'chrome', 'mozilla'])
        && details.standardSoftware.keys().hasOnly(['office365', 'antivirus', 'adobeReader', 'sevenZip', 'chrome', 'mozilla'])
        && details.standardSoftware.office365 is bool
        && details.standardSoftware.antivirus is bool
        && details.standardSoftware.adobeReader is bool
        && details.standardSoftware.sevenZip is bool
        && details.standardSoftware.chrome is bool
        && details.standardSoftware.mozilla is bool;
      let requestedSoftwareValid = details.requestedSoftware is map
        && details.requestedSoftware.keys().hasAll(['tns', 'tipificador', 'progsalud', 'ccleaner', 'ipscan', 'anydesk'])
        && details.requestedSoftware.keys().hasOnly(['tns', 'tipificador', 'progsalud', 'ccleaner', 'ipscan', 'anydesk'])
        && details.requestedSoftware.tns is bool
        && details.requestedSoftware.tipificador is bool
        && details.requestedSoftware.progsalud is bool
        && details.requestedSoftware.ccleaner is bool
        && details.requestedSoftware.ipscan is bool
        && details.requestedSoftware.anydesk is bool;
      let discountSourcesValid = details.discountSources is map
        && details.discountSources.keys().hasAll(['fees', 'salary', 'benefits'])
        && details.discountSources.keys().hasOnly(['fees', 'salary', 'benefits'])
        && details.discountSources.fees is bool
        && details.discountSources.salary is bool
        && details.discountSources.benefits is bool;
      let textFieldsValid = (!details.keys().hasAny(['deliveredByName']) || isOptionalString(details.deliveredByName, 200))
        && (!details.keys().hasAny(['otherDeviceType']) || isOptionalString(details.otherDeviceType, 100))
        && (!details.keys().hasAny(['charger']) || isOptionalString(details.charger, 100))
        && (!details.keys().hasAny(['mouse']) || isOptionalString(details.mouse, 100))
        && (!details.keys().hasAny(['monitor']) || isOptionalString(details.monitor, 150))
        && (!details.keys().hasAny(['license']) || isOptionalString(details.license, 150))
        && (!details.keys().hasAny(['keyboard']) || isOptionalString(details.keyboard, 100))
        && (!details.keys().hasAny(['phoneSerial']) || isOptionalString(details.phoneSerial, 100))
        && (!details.keys().hasAny(['phoneImei']) || isOptionalString(details.phoneImei, 100))
        && (!details.keys().hasAny(['otherSoftware']) || isOptionalString(details.otherSoftware, 1000))
        && (!details.keys().hasAny(['partyType']) || details.partyType in ['employee', 'contractor'])
        && (!details.keys().hasAny(['discountAmountWords']) || isOptionalString(details.discountAmountWords, 300))
        && (!details.keys().hasAny(['discountAmountValue']) || isOptionalString(details.discountAmountValue, 80));
      return identityValid && deviceTypesValid && standardSoftwareValid && requestedSoftwareValid && discountSourcesValid && textFieldsValid;
    }

    // El borrador valida la estructura necesaria para imprimir, sin repetir todas
    // las validaciones exhaustivas usadas al editar un acta. Las reglas de
    // Firestore tienen un límite de evaluación por escritura; la comprobación
    // completa de cada checkbox y campo opcional hacía que el alta lo superara.
    function actDraftDocumentDetailsValid(details) {
      return details is map
        && details.keys().hasAll(['deviceTypes', 'standardSoftware', 'requestedSoftware', 'discountSources'])
        && details.keys().hasOnly([
          'deliveredByName', 'deviceTypes', 'otherDeviceType', 'charger', 'mouse', 'monitor', 'license',
          'keyboard', 'phoneSerial', 'phoneImei', 'standardSoftware', 'requestedSoftware',
          'otherSoftware', 'partyType', 'discountSources', 'discountAmountWords', 'discountAmountValue'
        ])
        && details.deviceTypes is map
        && details.deviceTypes.keys().hasAll(['desktop', 'laptop', 'printer', 'tablet', 'cellphone', 'other'])
        && details.deviceTypes.keys().hasOnly(['desktop', 'laptop', 'printer', 'tablet', 'cellphone', 'other'])
        && details.standardSoftware is map
        && details.standardSoftware.keys().hasAll(['office365', 'antivirus', 'adobeReader', 'sevenZip', 'chrome', 'mozilla'])
        && details.standardSoftware.keys().hasOnly(['office365', 'antivirus', 'adobeReader', 'sevenZip', 'chrome', 'mozilla'])
        && details.requestedSoftware is map
        && details.requestedSoftware.keys().hasAll(['tns', 'tipificador', 'progsalud', 'ccleaner', 'ipscan', 'anydesk'])
        && details.requestedSoftware.keys().hasOnly(['tns', 'tipificador', 'progsalud', 'ccleaner', 'ipscan', 'anydesk'])
        && details.discountSources is map
        && details.discountSources.keys().hasAll(['fees', 'salary', 'benefits'])
        && details.discountSources.keys().hasOnly(['fees', 'salary', 'benefits']);
    }

    function actDraftCreateDataValid() {
      let data = request.resource.data;
      let identityValid = data.keys().hasAll([
          'assetId', 'siteId', 'companyId', 'templateId', 'fixedAssetIdSnapshot',
          'assetSnapshot', 'recipient', 'companyNitSnapshot', 'documentDetails',
          'status', 'createdAt', 'createdByUid'
        ])
        && data.keys().hasOnly([
          'assetId', 'siteId', 'companyId', 'templateId', 'templateVersion',
          'fixedAssetIdSnapshot', 'assetSnapshot', 'recipient', 'companyNitSnapshot',
          'documentDetails', 'observations', 'status', 'contentRevision', 'createdAt', 'createdByUid'
        ])
        && isNonEmptyString(data.assetId, 150)
        && isNonEmptyString(data.siteId, 150)
        && isNonEmptyString(data.companyId, 100)
        && data.templateId == data.companyId
        && isNonEmptyString(data.fixedAssetIdSnapshot, 50)
        && isNonEmptyString(data.companyNitSnapshot, 80)
        && data.status == 'draft'
        && (!data.keys().hasAny(['contentRevision']) || (data.contentRevision is int && data.contentRevision == 1))
        && data.createdAt is int
        && data.createdAt > 0
        && data.createdByUid == request.auth.uid
        && (!data.keys().hasAny(['templateVersion']) || (data.templateVersion is int && data.templateVersion >= 1))
        && (!data.keys().hasAny(['observations']) || isOptionalString(data.observations, 4000));
      let snapshotValid = data.assetSnapshot is map
        && data.assetSnapshot.keys().hasAll(['type', 'brand', 'model', 'serial'])
        && data.assetSnapshot.keys().hasOnly(['type', 'brand', 'model', 'serial', 'processor', 'ram', 'storage', 'os'])
        && isNonEmptyString(data.assetSnapshot.type, 50)
        && isNonEmptyString(data.assetSnapshot.brand, 100)
        && isNonEmptyString(data.assetSnapshot.model, 150)
        && isNonEmptyString(data.assetSnapshot.serial, 150);
      let recipientValid = data.recipient is map
        && data.recipient.keys().hasAll(['fullName', 'position', 'documentNumber'])
        && data.recipient.keys().hasOnly(['fullName', 'position', 'email', 'documentNumber', 'area', 'phone', 'extension', 'networkUser'])
        && isNonEmptyString(data.recipient.fullName, 200)
        && isNonEmptyString(data.recipient.position, 150)
        && isNonEmptyString(data.recipient.documentNumber, 80);
      let site = get(/databases/$(database)/documents/sites/$(data.siteId)).data;
      let asset = get(/databases/$(database)/documents/assets/$(data.assetId)).data;
      let referencesValid = exists(/databases/$(database)/documents/sites/$(data.siteId))
        && exists(/databases/$(database)/documents/assets/$(data.assetId))
        && asset.siteId == data.siteId
        && site.companyId == data.companyId
        && asset.status == 'asignado'
        && asset.currentAssignment is map
        && isNonEmptyString(asset.currentAssignment.assignedToName, 200)
        && isNonEmptyString(asset.currentAssignment.assignedToPosition, 150)
        && isNonEmptyString(asset.currentAssignment.assignedToResponsible, 200);
      return identityValid && snapshotValid && recipientValid && actDraftDocumentDetailsValid(data.documentDetails) && referencesValid;
    }

    function actPdfFileValid(actId, value) {
      return value == null
        || (
          value is map
          && value.keys().hasAll(['url', 'path', 'name', 'contentType', 'size'])
          && isNonEmptyString(value.url, 2048)
          && isValidActPdfPath(actId, value.path)
          && isNonEmptyString(value.name, 256)
          && value.contentType == 'application/pdf'
          && (value.size is int || value.size is float)
          && value.size > 0
          && value.size <= 10 * 1024 * 1024
        );
    }

    function actPdfHistoryValid(value) {
      return value == null
        || (value is list && value.size() <= 10);
    }

    function actLegacyReviewDataValid(actId) {
      let data = request.resource.data;
      let classificationValid = !data.keys().hasAny(['legacyClassification'])
        || data.legacyClassification in ['pending', 'issued', 'signed_uploaded'];
      let reasonValid = !data.keys().hasAny(['legacyClassificationReason'])
        || isOptionalString(data.legacyClassificationReason, 2000);
      let dateValid = !data.keys().hasAny(['legacyClassifiedAt'])
        || (data.legacyClassifiedAt == null || (data.legacyClassifiedAt is int && data.legacyClassifiedAt > 0));
      let reviewerValid = !data.keys().hasAny(['legacyClassifiedByUid'])
        || isOptionalString(data.legacyClassifiedByUid, 150);
      let unknownDateValid = !data.keys().hasAny(['legacySignatureDateUnknown'])
        || data.legacySignatureDateUnknown is bool;
      let unknownSignerValid = !data.keys().hasAny(['legacySignerUnknown'])
        || data.legacySignerUnknown is bool;
      let issuedStateValid = !data.keys().hasAny(['legacyClassification'])
        || data.legacyClassification != 'issued'
        || (data.status == 'issued' && data.keys().hasAny(['generatedPdf']) && actPdfFileValid(actId, data.generatedPdf));
      let signedStateValid = !data.keys().hasAny(['legacyClassification'])
        || data.legacyClassification != 'signed_uploaded'
        || (data.status == 'signed'
          && data.signatureMethod == 'uploaded_pdf'
          && data.keys().hasAny(['signedPdf'])
          && actPdfFileValid(actId, data.signedPdf));
      return classificationValid && reasonValid && dateValid && reviewerValid && unknownDateValid && unknownSignerValid && issuedStateValid && signedStateValid;
    }

    function actSignatureValid(actId) {
      let data = request.resource.data;
      let methodValid = !data.keys().hasAny(['signatureMethod'])
        || data.signatureMethod == null
        || data.signatureMethod == ''
        || data.signatureMethod == 'uploaded_pdf'
        || (data.signatureMethod == 'electronic'
          && exists(/databases/$(database)/documents/acts/$(actId))
          && resource.data.keys().hasAny(['signatureMethod'])
          && resource.data.signatureMethod == 'electronic');
      let signerValid = !data.keys().hasAny(['signedByUid'])
        || (
          data.signedByUid is string
          && (
            (!exists(/databases/$(database)/documents/acts/$(actId)) && data.signedByUid == request.auth.uid)
            || (
              exists(/databases/$(database)/documents/acts/$(actId))
              && (
                (resource.data.status != 'signed' && data.signedByUid == request.auth.uid)
                || (resource.data.status == 'signed' && resource.data.keys().hasAny(['signedByUid']) && data.signedByUid == resource.data.signedByUid)
                || (resource.data.status == 'signed'
                  && resource.data.keys().hasAny(['pdfUrl'])
                  && !resource.data.keys().hasAny(['signatureMethod', 'signedPdf'])
                  && isAdmin()
                  && data.signedByUid == request.auth.uid)
              )
            )
          )
        );
      let signedValid = data.status != 'signed'
        || (
          data.keys().hasAll(['signatureMethod', 'signedAt', 'signedByUid', 'signedPdf'])
          && data.signatureMethod in ['electronic', 'uploaded_pdf']
          && data.signedAt is int
          && data.signedAt > 0
          && actPdfFileValid(actId, data.signedPdf)
          && signerValid
        );
      let methodStateValid = !data.keys().hasAny(['signatureMethod'])
        || data.signatureMethod == null
        || data.signatureMethod == ''
        || (data.status == 'signed' && data.keys().hasAny(['signedPdf']) && actPdfFileValid(actId, data.signedPdf));
      let generatedValid = !data.keys().hasAny(['generatedPdf']) || actPdfFileValid(actId, data.generatedPdf);
      let historyValid = !data.keys().hasAny(['signedPdfHistory']) || actPdfHistoryValid(data.signedPdfHistory);
      let historyStateValid = !data.keys().hasAny(['signedPdfHistory'])
        || (data.status == 'signed' && data.signatureMethod == 'uploaded_pdf');
      return methodValid && signedValid && methodStateValid && generatedValid && historyValid && historyStateValid;
    }

    function actRevisionCreateValid(actId, revisionId) {
      let actPath = /databases/$(database)/documents/acts/$(actId);
      let current = get(actPath).data;
      let next = getAfter(actPath).data;
      let data = request.resource.data;
      let before = data.before;
      let after = data.after;
      let beforeObservationsValid = current.keys().hasAny(['observations'])
        ? before.observations == current.observations
        : before.observations == '';
      let beforeDetailsValid = current.keys().hasAny(['documentDetails'])
        ? before.documentDetails == current.documentDetails
        : before.documentDetails.keys().size() == 0;
      return data.keys().hasAll([
          'actId', 'revision', 'reason', 'fromStatus', 'toStatus', 'before', 'after', 'createdAt', 'createdByUid'
        ])
        && data.keys().hasOnly([
          'actId', 'revision', 'reason', 'fromStatus', 'toStatus', 'before', 'after', 'createdAt', 'createdByUid'
        ])
        && data.actId == actId
        && data.revision is int
        && data.revision == next.contentRevision
        && data.reason is string
        && data.reason.size() >= 5
        && data.reason.size() <= 500
        && data.fromStatus == current.status
        && data.toStatus == next.status
        && data.createdAt is int
        && data.createdAt > 0
        && data.createdAt == next.lastEditedAt
        && data.createdByUid == request.auth.uid
        && data.createdByUid == next.lastEditedByUid
        && revisionId == next.lastEditId
        && data.reason == next.lastEditReason
        && before is map
        && before.keys().hasAll(['recipient', 'observations', 'documentDetails'])
        && before.keys().hasOnly(['recipient', 'observations', 'documentDetails'])
        && before.recipient == current.recipient
        && beforeDetailsValid
        && beforeObservationsValid
        && after is map
        && after.keys().hasAll(['recipient', 'observations', 'documentDetails'])
        && after.keys().hasOnly(['recipient', 'observations', 'documentDetails'])
        && after.recipient == next.recipient
        && after.observations == next.observations
        && after.documentDetails == next.documentDetails
        && actDocumentDetailsValid(next.documentDetails);
    }

    function actContentEditValid(actId) {
      let current = resource.data;
      let next = request.resource.data;
      let changed = next.diff(current).affectedKeys();
      let currentRevision = current.keys().hasAny(['contentRevision']) ? current.contentRevision : 1;
      let revisionId = next.keys().hasAny(['lastEditId']) && next.lastEditId is string ? next.lastEditId : '__invalid__';
      let revision = getAfter(/databases/$(database)/documents/acts/$(actId)/revisions/$(revisionId)).data;
      let editFields = [
        'recipient', 'observations', 'documentDetails', 'contentRevision', 'lastEditId',
        'lastEditedAt', 'lastEditedByUid', 'lastEditReason', 'updatedAt', 'updatedByUid',
        'status', 'issuedAt', 'generatedPdf', 'pdfUrl', 'pdfPath', 'pdfName', 'pdfContentType', 'pdfSize'
      ];
      let printedFileCleared = current.status != 'issued'
        || (!next.keys().hasAny(['issuedAt'])
          && next.keys().hasAny(['generatedPdf']) && next.generatedPdf == null
          && next.keys().hasAny(['pdfUrl']) && next.pdfUrl == null
          && next.keys().hasAny(['pdfPath']) && next.pdfPath == null
          && next.keys().hasAny(['pdfName']) && next.pdfName == null
          && next.keys().hasAny(['pdfContentType']) && next.pdfContentType == null
          && next.keys().hasAny(['pdfSize']) && next.pdfSize == null);
      return current.status in ['draft', 'issued']
        && (!current.keys().hasAny(['signedPdf']) || current.signedPdf == null)
        && (!current.keys().hasAny(['signatureMethod']) || current.signatureMethod == null || current.signatureMethod == '')
        && next.status == 'draft'
        && next.recipient is map
        && next.recipient.keys().hasAll(['fullName', 'position', 'documentNumber'])
        && isNonEmptyString(next.recipient.fullName, 200)
        && isNonEmptyString(next.recipient.position, 150)
        && isNonEmptyString(next.recipient.documentNumber, 80)
        && (!next.keys().hasAny(['observations']) || isOptionalString(next.observations, 4000))
        && actDocumentDetailsValid(next.documentDetails)
        && changed.hasAny(['recipient', 'observations', 'documentDetails'])
        && changed.hasAll(['contentRevision', 'lastEditId', 'lastEditedAt', 'lastEditedByUid', 'lastEditReason', 'updatedAt', 'updatedByUid'])
        && changed.hasOnly(editFields)
        && next.contentRevision is int
        && next.contentRevision == currentRevision + 1
        && next.lastEditId is string
        && next.lastEditId.size() > 0
        && next.lastEditId.size() <= 150
        && next.lastEditedAt is int
        && next.lastEditedAt > 0
        && next.lastEditedByUid == request.auth.uid
        && next.lastEditReason is string
        && next.lastEditReason.size() >= 5
        && next.lastEditReason.size() <= 500
        && printedFileCleared
        && revision.revision == next.contentRevision
        && revision.reason == next.lastEditReason
        && revision.createdAt == next.lastEditedAt
        && revision.createdByUid == request.auth.uid;
    }

    function actLifecycleUpdateValid(actId) {
      let current = resource.data;
      let next = request.resource.data;
      let changed = next.diff(current).affectedKeys();
      let currentStatus = current.status;
      let nextStatus = next.status;
      let legacyReviewUpdate = current.keys().hasAny(['pdfUrl'])
        && (!current.keys().hasAny(['generatedPdf']) || current.generatedPdf == null)
        && (!current.keys().hasAny(['signedPdf']) || current.signedPdf == null)
        && (!current.keys().hasAny(['signatureMethod']) || current.signatureMethod == null || current.signatureMethod == '')
        && isAdmin()
        && changed.hasAny(['legacyClassification'])
        && changed.hasOnly(['status', 'generatedPdf', 'signedPdf', 'signatureMethod', 'signedAt', 'signedByUid', 'issuedAt', 'legacyClassification', 'legacyClassificationReason', 'legacyClassifiedAt', 'legacyClassifiedByUid', 'legacySignatureDateUnknown', 'legacySignerUnknown', 'pdfUrl', 'pdfPath', 'pdfName', 'pdfContentType', 'pdfSize', 'updatedAt', 'updatedByUid']);
      let transitionValid = (currentStatus == 'draft' && nextStatus in ['draft', 'issued', 'signed', 'void'])
        || (currentStatus == 'issued' && nextStatus in ['issued', 'signed', 'void'])
        || (currentStatus == 'issued' && nextStatus == 'draft' && actContentEditValid(actId))
        || (currentStatus == 'signed' && nextStatus in ['signed', 'void'])
        || (currentStatus == 'void' && nextStatus == 'void')
        || (legacyReviewUpdate && nextStatus in ['draft', 'issued', 'signed']);
      let signedAuditOnly = changed.hasOnly(['updatedAt', 'updatedByUid', 'isDeleted', 'deletedAt', 'deletedByUid']);
      let uploadedPdfReplacement = currentStatus == 'signed'
        && current.keys().hasAny(['signatureMethod'])
        && current.signatureMethod in ['uploaded_pdf', 'electronic']
        && next.keys().hasAny(['signatureMethod'])
        && next.signatureMethod == 'uploaded_pdf'
        && changed.hasAll(['signedPdf', 'signedPdfHistory'])
        && changed.hasOnly(['signedPdf', 'signedPdfHistory', 'signatureMethod', 'signedAt', 'signedByUid', 'pdfUrl', 'pdfPath', 'pdfName', 'pdfContentType', 'pdfSize', 'updatedAt', 'updatedByUid', 'isDeleted', 'deletedAt', 'deletedByUid']);
      let signedLocked = currentStatus != 'signed'
        || signedAuditOnly
        || uploadedPdfReplacement
        || legacyReviewUpdate;
      let voidRestricted = nextStatus != 'void' || isAdmin();
      return transitionValid
        && (!changed.hasAny(['recipient', 'observations', 'documentDetails', 'contentRevision', 'lastEditId', 'lastEditedAt', 'lastEditedByUid', 'lastEditReason']) || actContentEditValid(actId))
        && signedLocked
        && voidRestricted;
    }

    function actLegacyReviewUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['legacyClassification', 'legacyClassificationReason', 'legacyClassifiedAt', 'legacyClassifiedByUid', 'legacySignatureDateUnknown', 'legacySignerUnknown'])
        || isAdmin();
    }

    function isLegacyActDocument() {
      return resource.data.keys().hasAll(['assetId', 'siteId', 'status', 'pdfUrl'])
        && resource.data.pdfUrl is string
        && resource.data.pdfUrl.size() > 0
        && resource.data.status in ['draft', 'issued', 'signed']
        && (!resource.data.keys().hasAny(['generatedPdf']) || resource.data.generatedPdf == null)
        && (!resource.data.keys().hasAny(['signedPdf']) || resource.data.signedPdf == null)
        && (!resource.data.keys().hasAny(['signatureMethod']) || resource.data.signatureMethod == null || resource.data.signatureMethod == '');
    }

    // Migración controlada de actas antiguas: no permite editar el contenido
    // del acta ni sus referencias; únicamente clasifica el PDF heredado.
    function legacyClassificationUpdateValid(actId) {
      let current = resource.data;
      let next = request.resource.data;
      let changed = next.diff(current).affectedKeys();
      let allowedFields = [
        'status', 'generatedPdf', 'signedPdf', 'signatureMethod', 'signedAt',
        'signedByUid', 'issuedAt', 'legacyClassification',
        'legacyClassificationReason', 'legacyClassifiedAt',
        'legacyClassifiedByUid', 'legacySignatureDateUnknown',
        'legacySignerUnknown', 'updatedAt', 'updatedByUid'
      ];
      let baseValid = isLegacyActDocument()
        && isAdmin()
        && canReadSite(current.siteId)
        && next.keys().hasAll(['assetId', 'siteId'])
        && next.assetId == current.assetId
        && next.siteId == current.siteId
        && changed.hasAny(['legacyClassification'])
        && changed.hasOnly(allowedFields)
        && auditUpdateValid()
        && softDeleteValid();
      let reviewMetadataValid = next.keys().hasAny(['legacyClassification'])
        && next.legacyClassification in ['pending', 'issued', 'signed_uploaded']
        && next.keys().hasAny(['legacyClassificationReason'])
        && next.legacyClassificationReason is string
        && next.legacyClassificationReason.size() >= 5
        && next.legacyClassificationReason.size() <= 2000
        && next.keys().hasAny(['legacyClassifiedAt'])
        && next.legacyClassifiedAt is int
        && next.legacyClassifiedAt > 0
        && next.keys().hasAny(['legacyClassifiedByUid'])
        && next.legacyClassifiedByUid is string
        && next.legacyClassifiedByUid.size() > 0
        && next.legacyClassifiedByUid.size() <= 150
        && next.legacyClassifiedByUid == request.auth.uid
        && next.keys().hasAll(['legacySignatureDateUnknown', 'legacySignerUnknown'])
        && next.legacySignatureDateUnknown is bool
        && next.legacySignerUnknown is bool;
      let pendingValid = next.legacyClassification == 'pending'
        && next.status == current.status
        && (!next.keys().hasAny(['generatedPdf']) || next.generatedPdf == null)
        && (!next.keys().hasAny(['signedPdf']) || next.signedPdf == null)
        && (!next.keys().hasAny(['signatureMethod']) || next.signatureMethod == null || next.signatureMethod == '');
      let issuedValid = next.legacyClassification == 'issued'
        && next.status == 'issued'
        && next.keys().hasAny(['generatedPdf'])
        && actPdfFileValid(actId, next.generatedPdf);
      let signedValid = next.legacyClassification == 'signed_uploaded'
        && next.status == 'signed'
        && next.signatureMethod == 'uploaded_pdf'
        && next.keys().hasAll(['signedAt', 'signedByUid', 'signedPdf'])
        && next.signedAt is int
        && next.signedAt > 0
        && next.signedByUid == request.auth.uid
        && actPdfFileValid(actId, next.signedPdf);
      return baseValid
        && reviewMetadataValid
        && (pendingValid || issuedValid || signedValid);
    }

    function actTemplateDataValid(companyId) {
      let data = request.resource.data;
      let identityValid = data.keys().hasAll(['companyId', 'companyName', 'version', 'active'])
        && data.companyId == companyId
        && isNonEmptyString(data.companyId, 100)
        && isNonEmptyString(data.companyName, 150)
        && data.version is int
        && data.version >= 1
        && data.active is bool;
      let nitValid = !data.keys().hasAny(['nit']) || isOptionalString(data.nit, 80);
      let sourceValid = !data.keys().hasAny(['sourceDocxPath'])
        || data.sourceDocxPath == null
        || isValidActTemplatePath(data.companyId, 'source', data.sourceDocxPath);
      let pdfValid = !data.keys().hasAny(['pdfTemplatePath'])
        || data.pdfTemplatePath == null
        || isValidActTemplatePath(data.companyId, 'pdf', data.pdfTemplatePath);
      let placementValid = !data.keys().hasAny(['signaturePlacement'])
        || (
          data.signaturePlacement is map
          && data.signaturePlacement.keys().hasAll(['page', 'x', 'y', 'width', 'height'])
          && data.signaturePlacement.page is int
          && data.signaturePlacement.page >= 1
          && (data.signaturePlacement.x is int || data.signaturePlacement.x is float)
          && (data.signaturePlacement.y is int || data.signaturePlacement.y is float)
          && (data.signaturePlacement.width is int || data.signaturePlacement.width is float)
          && (data.signaturePlacement.height is int || data.signaturePlacement.height is float)
          && data.signaturePlacement.width > 0
          && data.signaturePlacement.height > 0
        );
      return identityValid && nitValid && sourceValid && pdfValid && placementValid;
    }

    function maintenanceDataValid() {
      let data = request.resource.data;
      let identityValid = data.keys().hasAll(['assetId', 'siteId', 'type', 'status'])
        && isNonEmptyString(data.assetId, 150)
        && isNonEmptyString(data.siteId, 150)
        && data.type in ['preventivo', 'correctivo']
        && data.status in ['programado', 'en_proceso', 'realizado', 'cancelado'];
      let datesValid = (!data.keys().hasAny(['scheduledDate']) || isOptionalDate(data.scheduledDate))
        && (!data.keys().hasAny(['completedDate']) || isOptionalDate(data.completedDate))
        && (!data.keys().hasAny(['nextMaintenanceDate']) || isOptionalDate(data.nextMaintenanceDate));
      let costValid = !data.keys().hasAny(['cost'])
        || data.cost == null
        || ((data.cost is int || data.cost is float) && data.cost >= 0);
      let textValid = (!data.keys().hasAny(['technicianName']) || isOptionalString(data.technicianName, 200))
        && (!data.keys().hasAny(['findings']) || isOptionalString(data.findings, 4000))
        && (!data.keys().hasAny(['actionsTaken']) || isOptionalString(data.actionsTaken, 4000))
        && (!data.keys().hasAny(['evidenceUrl']) || isOptionalString(data.evidenceUrl, 2048))
        && (!data.keys().hasAny(['evidenceName']) || isOptionalString(data.evidenceName, 256));
      let supplierValid = !data.keys().hasAny(['supplierId'])
        || data.supplierId == null
        || data.supplierId == ''
        || (data.supplierId is string && exists(/databases/$(database)/documents/suppliers/$(data.supplierId)));
      let refsValid = data.keys().hasAll(['siteId', 'assetId'])
        && data.siteId is string
        && data.assetId is string
        && exists(/databases/$(database)/documents/sites/$(data.siteId))
        && exists(/databases/$(database)/documents/assets/$(data.assetId))
        && get(/databases/$(database)/documents/assets/$(data.assetId)).data.siteId == data.siteId;
      return identityValid && datesValid && costValid && textValid && supplierValid && refsValid;
    }

    function invoiceAttachmentValid(invoiceId) {
      let data = request.resource.data;

      let pdfPathOk = !data.keys().hasAny(['pdfPath'])
        || data.pdfPath == null
        || isValidInvoiceAttachmentPath(invoiceId, data.pdfPath);

      let pdfUrlOk = !data.keys().hasAny(['pdfUrl'])
        || isNullOrShortString(data.pdfUrl, 2048);

      let pdfNameOk = !data.keys().hasAny(['pdfName'])
        || isNullOrShortString(data.pdfName, 256);

      let pdfContentTypeOk = !data.keys().hasAny(['pdfContentType'])
        || data.pdfContentType == null
        || isValidInvoiceContentType(data.pdfContentType);

      let pdfSizeOk = !data.keys().hasAny(['pdfSize'])
        || (
          isNullOrIntOrFloat(data.pdfSize)
          && (data.pdfSize == null || (data.pdfSize >= 0 && data.pdfSize <= 10 * 1024 * 1024))
        );

      return pdfPathOk && pdfUrlOk && pdfNameOk && pdfContentTypeOk && pdfSizeOk;
    }

    // El estado de pago y el comprobante solo los actualiza la callable que
    // verifica el objeto real en Storage. Los clientes no pueden forjarlos.
    function invoicePaymentCreateValid() {
      let data = request.resource.data;
      return data.status == 'pending'
        && !data.keys().hasAny(['paymentReceipt']);
    }

    function invoicePaymentUpdateValid() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !changedKeys.hasAny(['status', 'paymentReceipt']);
    }

    function quoteAttachmentValid(quoteId) {
      let data = request.resource.data;

      let pdfPathOk = !data.keys().hasAny(['pdfPath'])
        || data.pdfPath == null
        || isValidQuoteAttachmentPath(quoteId, data.pdfPath);

      let pdfUrlOk = !data.keys().hasAny(['pdfUrl'])
        || isNullOrShortString(data.pdfUrl, 2048);

      let pdfNameOk = !data.keys().hasAny(['pdfName'])
        || isNullOrShortString(data.pdfName, 256);

      let pdfContentTypeOk = !data.keys().hasAny(['pdfContentType'])
        || data.pdfContentType == null
        || (data.pdfContentType is string && data.pdfContentType.matches('application/pdf'));

      let pdfSizeOk = !data.keys().hasAny(['pdfSize'])
        || (
          isNullOrIntOrFloat(data.pdfSize)
          && (data.pdfSize == null || (data.pdfSize >= 0 && data.pdfSize <= 10 * 1024 * 1024))
        );

      return pdfPathOk && pdfUrlOk && pdfNameOk && pdfContentTypeOk && pdfSizeOk;
    }

    function actAttachmentValid(actId) {
      let data = request.resource.data;

      let pdfPathOk = !data.keys().hasAny(['pdfPath'])
        || data.pdfPath == null
        || isValidActPdfPath(actId, data.pdfPath);

      let pdfUrlOk = !data.keys().hasAny(['pdfUrl'])
        || isNullOrShortString(data.pdfUrl, 2048);

      let pdfNameOk = !data.keys().hasAny(['pdfName'])
        || isNullOrShortString(data.pdfName, 256);

      let pdfContentTypeOk = !data.keys().hasAny(['pdfContentType'])
        || data.pdfContentType == null
        || (data.pdfContentType is string && data.pdfContentType.matches('application/pdf'));

      let pdfSizeOk = !data.keys().hasAny(['pdfSize'])
        || (
          isNullOrIntOrFloat(data.pdfSize)
          && (data.pdfSize == null || (data.pdfSize >= 0 && data.pdfSize <= 10 * 1024 * 1024))
        );

      return pdfPathOk && pdfUrlOk && pdfNameOk && pdfContentTypeOk && pdfSizeOk;
    }

    // USERS (perfiles)
    match /users/{uid} {
      allow read: if profileActive() && (uid == request.auth.uid || isAdmin());

      // Solo admin puede crear perfiles.
      allow create: if isAdmin() && userProfileValid();

      // El usuario puede actualizar su nombre; solo admin puede cambiar role/email.
      allow update: if isSignedIn() && (
        (uid == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name']))
        || (isAdmin()
          && userProfileValid()
          // El estado de Auth se cambia exclusivamente por la Cloud Function.
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['active']))
      ) && profileActive();

      allow delete: if isAdmin();
    }

    // SITES
    match /sites/{siteId} {
      allow read: if canReadSite(siteId);
      allow create: if canWrite() && hasGlobalAccess()
        && siteDataValid()
        && auditCreateValid();
      allow update: if canWriteSite(siteId)
        && siteDataValid()
        && auditUpdateValid()
        && softDeleteValid()
        && (!request.resource.data.keys().hasAny(['isDeleted']) || request.resource.data.isDeleted != true || isAdmin()); // incluye assetSeq
      allow delete: if false;
    }

    // ASSETS
    match /assets/{assetId} {
      allow read: if canReadSite(resource.data.siteId);
      allow create: if canWriteSite(request.resource.data.siteId)
        && assetDataValid()
        && siteReferenceValid()
        && assetAttachmentValid(assetId)
        && assetLifecycleValid()
        && auditCreateValid();
      allow update: if canWriteSite(resource.data.siteId)
        && canWriteSite(request.resource.data.siteId)
        && (
          assetImageUpdateValid(assetId)
          || assetAssignmentUpdateValid()
          || assetStatusUpdateValid()
          || assetLegacyFieldUpdateValid()
          || (
            assetDataValid()
            && siteReferenceValid()
            && assetAttachmentValid(assetId)
            && assetLifecycleValid()
            && auditUpdateValid()
            && softDeleteValid()
            // La baja es un estado final; no se puede reactivar por una edición común.
            && (resource.data.status != 'baja' || request.resource.data.status == 'baja')
          )
        );
      allow delete: if false;
    }

    // ACTIVITIES
    match /activities/{activityId} {
      allow read: if canReadSite(resource.data.siteId);
      allow create: if canWriteSite(request.resource.data.siteId)
        && activityDataValid()
        && activityReferencesValid()
        && auditCreateValid();
      allow update: if canWriteSite(resource.data.siteId)
        && canWriteSite(request.resource.data.siteId)
        && activityDataValid()
        && activityReferencesValid()
        && auditUpdateValid()
        && softDeleteValid();
      allow delete: if false;
    }

    // SUPPLIERS
    match /suppliers/{supplierId} {
      // Catálogo compartido; las transacciones que lo usan sí están limitadas por sede.
      allow read: if profileActive();
      allow create: if (isAdmin() || (isTech() && hasGlobalAccess()))
        && supplierDataValid()
        && auditCreateValid();
      allow update: if (isAdmin() || (isTech() && hasGlobalAccess()))
        && supplierDataValid()
        && auditUpdateValid()
        && softDeleteValid();
      allow delete: if false;
    }

    // GOOGLE ONE: lectura financiera; solo administración/técnicos globales pueden editar.
    match /googleOneAccounts/{accountId} {
      allow read: if canReadContracts();
      allow create: if canManageContracts()
        && googleOneAccountDataValid(accountId)
        && auditCreateValid();
      allow update: if canManageContracts()
        && googleOneAccountDataValid(accountId)
        && request.resource.data.accountEmail == resource.data.accountEmail
        && auditUpdateValid();
      allow delete: if false;
    }

    // CONTRATOS: gestión administrativa/técnica global; gerencia y auditoría solo lectura.
    match /contracts/{contractId} {
      allow read: if canReadContracts();
      allow create: if canManageContracts()
        && supplierContractDataValid(contractId)
        && auditCreateValid();
      allow update: if canManageContracts()
        && supplierContractDataValid(contractId)
        && request.resource.data.supplierId == resource.data.supplierId
        && auditUpdateValid();
      allow delete: if false;

      match /documents/{documentId} {
        allow read: if exists(/databases/$(database)/documents/contracts/$(contractId))
          && canReadContracts();
        allow create: if exists(/databases/$(database)/documents/contracts/$(contractId))
          && canManageContracts()
          && supplierContractDocumentDataValid(contractId, documentId);
        allow update: if canManageContracts()
          && supplierContractRenewalPeriodUpdateValid(contractId, documentId);
        allow delete: if false;
      }
    }

    // INVOICES
    match /invoices/{invoiceId} {
      allow read: if canReadSite(resource.data.siteId);
      allow create: if canWriteSite(request.resource.data.siteId)
        && invoiceDataValid()
        && invoicePaymentCreateValid()
        && invoiceAttachmentValid(invoiceId)
        && auditCreateValid();
      allow update: if canWriteSite(resource.data.siteId)
        && canWriteSite(request.resource.data.siteId)
        && invoiceDataValid()
        && invoicePaymentUpdateValid()
        && invoiceAttachmentValid(invoiceId)
        && auditUpdateValid()
        && softDeleteValid()
        && (!request.resource.data.keys().hasAny(['isDeleted']) || request.resource.data.isDeleted != true || isAdmin());
      allow delete: if false;
    }

    // QUOTES (Cotizaciones)
    match /quotes/{quoteId} {
      allow read: if canReadSite(resource.data.siteId);
      allow create: if canWriteSite(request.resource.data.siteId)
        && quoteDataValid()
        && quoteAttachmentValid(quoteId)
        && auditCreateValid();
      allow update: if canWriteSite(resource.data.siteId)
        && canWriteSite(request.resource.data.siteId)
        && quoteDataValid()
        && quoteAttachmentValid(quoteId)
        && auditUpdateValid()
        && softDeleteValid()
        && (!request.resource.data.keys().hasAny(['isDeleted']) || request.resource.data.isDeleted != true || isAdmin());
      allow delete: if false;
    }

    // ACTS (Actas de entrega)
    match /acts/{actId} {
      allow read: if canReadSite(resource.data.siteId);
      allow create: if canCreateActOnSite(request.resource.data.siteId)
        && actDraftCreateDataValid();
      allow update: if !isLegacyActDocument()
        && canWriteSite(resource.data.siteId)
        && canWriteSite(request.resource.data.siteId)
        && actDataValid()
        && actSignatureValid(actId)
        && actLegacyReviewDataValid(actId)
        && actAttachmentValid(actId)
        && auditUpdateValid()
        && softDeleteValid()
        && actLifecycleUpdateValid(actId)
        && actLegacyReviewUpdateAllowed()
        && (!request.resource.data.keys().hasAny(['isDeleted']) || request.resource.data.isDeleted != true || isAdmin());
      allow update: if legacyClassificationUpdateValid(actId);
      allow delete: if false;

      match /revisions/{revisionId} {
        allow read: if exists(/databases/$(database)/documents/acts/$(actId))
          && canReadSite(get(/databases/$(database)/documents/acts/$(actId)).data.siteId);
        allow create: if exists(/databases/$(database)/documents/acts/$(actId))
          && canWriteSite(get(/databases/$(database)/documents/acts/$(actId)).data.siteId)
          && actRevisionCreateValid(actId, revisionId);
        allow update, delete: if false;
      }
    }

    // Datos legales de empresa para impresión de actas: solo administradores pueden configurarlos.
    match /actTemplates/{companyId} {
      allow read: if profileActive();
      allow create: if isAdmin() && actTemplateDataValid(companyId) && auditCreateValid();
      allow update: if isAdmin() && actTemplateDataValid(companyId) && auditUpdateValid();
      allow delete: if false;
    }

    // MAINTENANCES
    match /maintenances/{maintenanceId} {
      allow read: if canReadSite(resource.data.siteId);
      allow create: if canWriteSite(request.resource.data.siteId)
        && maintenanceDataValid()
        && (!request.resource.data.keys().hasAny(['evidencePath']) || request.resource.data.evidencePath == null || isValidMaintenanceEvidencePath(maintenanceId, request.resource.data.evidencePath))
        && auditCreateValid();
      allow update: if canWriteSite(resource.data.siteId)
        && canWriteSite(request.resource.data.siteId)
        && maintenanceDataValid()
        && (!request.resource.data.keys().hasAny(['evidencePath']) || request.resource.data.evidencePath == null || isValidMaintenanceEvidencePath(maintenanceId, request.resource.data.evidencePath))
        && auditUpdateValid()
        && softDeleteValid()
        && (!request.resource.data.keys().hasAny(['isDeleted']) || request.resource.data.isDeleted != true || isAdmin())
        && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDeleted', 'deletedAt', 'deletedByUid']));
      allow delete: if false; // physical delete blocked
    }
  }
}
